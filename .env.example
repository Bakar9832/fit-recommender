# Postgres connection string used by Prisma (datasource db.url).
# Copy this file to .env and fill in real credentials. Keep .env out of git.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/fit_recommender?schema=public"

# Port the API listens on (optional; defaults to 3000).
PORT=3000
